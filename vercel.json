{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|uploads/|reports/|css/|js/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
